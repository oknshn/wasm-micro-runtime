# Object build statements for OBJECT_LIBRARY target offsets


#############################################
# Order-only phony target for offsets

build cmake_object_order_depends_target_offsets: phony || cmake_object_order_depends_target_nmsis_dsp zephyr/device_api_ld_target zephyr/driver_validation_h_target zephyr/kobj_types_h_target zephyr/syscall_list_h_target

