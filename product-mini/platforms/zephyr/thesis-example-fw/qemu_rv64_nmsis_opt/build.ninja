  DEFINES = -DKERNEL -DK_HEAP_MEM_POOL_SIZE=0 -DRISCV_MATH_LOOPUNROLL -DZVFS_OPEN_SIZE=0 -D_POSIX_THREAD_SAFE_FUNCTIONS=200809L -D__LINUX_ERRNO_EXTENSIONS__ -D__ZEPHYR__=1
